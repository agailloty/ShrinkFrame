# Copy this file to .env and adjust the public hostname or IP address before startup.
# Do not add Immich API keys here; configure connections in the ShrinkFrame UI.

# Host port mapped to the container's HTTP port 8080.
SHRINKFRAME_HTTP_PORT=5080

# Semicolon-separated hostnames/IP addresses accepted by ASP.NET Core.
# Replace shrinkframe.example.lan with the address used to open ShrinkFrame.
SHRINKFRAME_ALLOWED_HOSTS=shrinkframe.example.lan;localhost;127.0.0.1

# Exact browser-visible origin: scheme, hostname/IP, and port, without a trailing slash.
SHRINKFRAME_ORIGIN=http://shrinkframe.example.lan:5080

# Keep this many bytes free before storage admission reports pressure (5 GiB).
SHRINKFRAME_RESERVE_BYTES=5368709120

# Maximum size of one browser-uploaded input file (20 GiB).
SHRINKFRAME_MAX_INPUT_BYTES=21474836480

# CPU compression jobs run concurrently. One is recommended by default.
SHRINKFRAME_COMPRESSION_CONCURRENCY=1

# Immich source downloads run concurrently before compression begins.
SHRINKFRAME_ACQUISITION_CONCURRENCY=2
