<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ShrinkFrame.Application\ShrinkFrame.Application.csproj" />
    <ProjectReference Include="..\ShrinkFrame.Infrastructure\ShrinkFrame.Infrastructure.csproj" />
    <ProjectReference Include="..\ShrinkFrame.Domain\ShrinkFrame.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Make the SDK-provided ASP.NET Core static framework assets graph identical
         across setup-dotnet installations and the SDK container image. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
