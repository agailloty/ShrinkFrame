{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "WorkRoot": "/data/work",
    "MaximumFileSizeGigabytes": 20
  },
  "Worker": {
    "CompressionConcurrency": 1,
    "AcquisitionConcurrency": 2
  },
  "DataProtection": {
    "KeyRingPath": "/data/keys"
  },
  "AllowedHosts": "*"
}
