@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div class="top-row-copy">
                <span class="top-row-eyebrow">Video workspace</span>
                <span class="top-row-title">Compress with confidence</span>
            </div>
            <div class="version-pill" aria-label="Application version 1.0.0">
                <span class="version-dot" aria-hidden="true"></span>
                Version 1.0.0
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
