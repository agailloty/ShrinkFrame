@page "/storage"
@using ShrinkFrame.Application
@using ShrinkFrame.Domain
@inject IOperationsService Operations

<PageTitle>Storage</PageTitle><h1>Storage</h1>
@if(message is not null){<div class="alert @(success ? "alert-success" : "alert-danger")" role="alert"><strong>@messageCode</strong> @message</div>}
@if(error is not null){<div class="alert alert-danger"><strong>storage.load.failed</strong> @error <button class="btn btn-sm btn-outline-dark ms-2" @onclick="LoadAsync">Retry</button></div>}
else if(view is null){<p role="status">Loading storage inventory…</p>}
else {
 <div class="row g-3 mb-4"><div class="col-md-3"><div class="card"><div class="card-body"><h2 class="h6">Total</h2><p class="fs-4 mb-0">@Bytes(view.Summary.TotalBytes)</p></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><h2 class="h6">Free</h2><p class="fs-4 mb-0">@Bytes(view.Summary.FreeBytes)</p></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><h2 class="h6">Application usage</h2><p class="fs-4 mb-0">@Bytes(view.Summary.ApplicationBytes)</p></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><h2 class="h6">Orphans</h2><p class="fs-4 mb-0">@view.Summary.OrphanCount</p><p class="mb-0">@Bytes(view.Summary.OrphanBytes), report only</p></div></div></div></div>
 <h2 class="h4">Artifact ownership</h2>
 @if(view.Jobs.Count==0){<p>No job-owned artifacts or history.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Batch / job</th><th>Status</th><th>Age</th><th>Artifacts</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>@foreach(var row in view.Jobs){<tr><td><a href="@($"batches/{row.BatchId.Value:D}")">@row.BatchName</a><div class="small">@row.FileName</div></td><td>@row.State</td><td>@Age(row.UpdatedAt)</td><td>@row.ArtifactCount known · @Bytes(row.ArtifactBytes)</td><td class="text-end"><button class="btn btn-sm btn-outline-danger" disabled="@(!row.CanDelete)" title="@(row.CanDelete ? "Delete local artifacts and history" : "Active jobs cannot be deleted")" @onclick="()=>Select(row)">Delete…</button></td></tr>}</tbody></table></div>}
 @if(selected is not null){<section class="border border-danger rounded p-3 mb-4" aria-labelledby="confirm-delete"><h2 id="confirm-delete" class="h5">Confirm destructive local deletion</h2><p>Delete only the known artifacts and history for <strong>@selected.FileName</strong>? This cannot be undone.</p><div class="form-check mb-2"><input id="delete-confirm" type="checkbox" class="form-check-input" @bind="confirmed"/><label for="delete-confirm" class="form-check-label">I understand that this permanently deletes local artifacts and job history.</label></div><button class="btn btn-danger" disabled="@(!confirmed)" @onclick="DeleteAsync">Delete selected job</button> <button class="btn btn-secondary" @onclick="Cancel">Cancel</button></section>}
 <h2 class="h4">Orphan report</h2><p>Files not referenced by durable job records are reported and never deleted automatically.</p>@if(view.Orphans.Count==0){<p>No orphaned artifacts detected.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Opaque key</th><th>Size</th><th>Age</th></tr></thead><tbody>@foreach(var orphan in view.Orphans){<tr><td><code class="text-break">@orphan.Key.Key</code></td><td>@Bytes(orphan.SizeBytes)</td><td>@Age(orphan.LastModifiedAt)</td></tr>}</tbody></table></div>}
}
@code { private StoragePageView? view; private StorageJobView? selected; private bool confirmed,success; private string? error,message,messageCode; protected override Task OnInitializedAsync()=>LoadAsync(); private async Task LoadAsync(){try{error=null;view=await Operations.GetStorageAsync();}catch(Exception ex){error=ex.Message;}} private void Select(StorageJobView row){selected=row;confirmed=false;message=null;} private void Cancel(){selected=null;confirmed=false;} private async Task DeleteAsync(){if(selected is null)return;var result=await Operations.DeleteJobAsync(selected.JobId,confirmed); success=result.Succeeded;messageCode=result.Code;message=result.Message; if(result.Succeeded)Cancel(); await LoadAsync();} private static string Bytes(long value)=>value<1024?$"{value:N0} B":value<1024L*1024?$"{value/1024d:N1} KB":value<1024L*1024*1024?$"{value/1024d/1024d:N1} MB":$"{value/1024d/1024d/1024d:N1} GB"; private static string Age(DateTimeOffset value){var age=DateTimeOffset.Now-value;return age.TotalDays>=1?$"{age.TotalDays:N0} days":age.TotalHours>=1?$"{age.TotalHours:N0} hours":$"{Math.Max(0,age.TotalMinutes):N0} minutes";} }
