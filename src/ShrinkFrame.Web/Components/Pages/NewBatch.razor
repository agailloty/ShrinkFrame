@page "/new-batch"
@implements IAsyncDisposable
@using ShrinkFrame.Application
@using ShrinkFrame.Domain
@inject IJSRuntime JS
@inject IBatchWizard Wizard
@inject IWorkerStore WorkerStore
@inject IResultDelivery Results
@inject IImmichPublicationService Publications
@inject IImmichConnectionManager Connections
@inject IJobProgressHub ProgressHub
@inject TimeProvider Time

<PageTitle>New Batch</PageTitle>
<div class="page-heading wizard-heading">
    <div><div class="eyebrow">New batch</div><h1 class="mb-1">Create a compression batch</h1><p>@StepDescription</p></div>
    @if (batch is not null) { <span class="badge text-bg-light border">@batch.Name</span> }
</div>

<nav class="wizard-progress" aria-label="Batch progress">
    @foreach (var step in Steps)
    {
        <button type="button" class="wizard-progress__step @(activeStep == step.Number ? "is-current" : activeStep > step.Number ? "is-complete" : "")"
                aria-current="@(activeStep == step.Number ? "step" : null)" disabled="@(!CanOpenStep(step.Number))" @onclick="() => OpenStep(step.Number)">
            <span class="wizard-progress__number">@(activeStep > step.Number ? "✓" : step.Number)</span><span>@step.Label</span>
        </button>
    }
</nav>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div id="wizard-error" class="alert alert-danger wizard-error" role="alert" aria-live="assertive">
        <div><strong>@errorCode</strong><div>@error</div></div>
        <button type="button" class="btn btn-sm btn-outline-light" @onclick="DismissError" aria-label="Dismiss error">Dismiss</button>
    </div>
}

@if (activeStep == 1)
{
<section class="mb-4" aria-labelledby="source-heading">
    <h2 id="source-heading" class="h4">1. Source</h2>
    <div class="form-check"><input class="form-check-input" type="radio" name="source" id="browser-source" checked="@(sourceKind == SourceKind.BrowserUpload)" @onchange="() => SetSource(SourceKind.BrowserUpload)" disabled="@IsPersisted" /><label class="form-check-label" for="browser-source">Browser upload</label></div>
    <div class="form-check"><input class="form-check-input" type="radio" name="source" id="immich-source" checked="@(sourceKind == SourceKind.Immich)" @onchange="() => SetSource(SourceKind.Immich)" disabled="@IsPersisted" /><label class="form-check-label" for="immich-source">Immich</label></div>
    <label class="form-label mt-3" for="batch-name">Batch name</label>
    <input id="batch-name" class="form-control" maxlength="300" @bind="batchName" disabled="@IsLocked" required aria-describedby="batch-name-help" />
    <div id="batch-name-help" class="form-text">Generated for convenience; you can edit it until confirmation.</div>
</section>
<div class="wizard-actions"><span></span><button class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(batchName))" @onclick="() => OpenStep(2)">Continue to videos</button></div>
}

@if (activeStep == 2)
{
<section class="mb-4" aria-labelledby="videos-heading">
    <h2 id="videos-heading" class="h4">2. Select videos</h2>
    @if (sourceKind == SourceKind.Immich)
    {
        <ImmichVideoBrowser ConnectionChanged="ImmichConnectionChangedAsync" SelectionChanged="ImmichSelectionChanged" ErrorChanged="ImmichBrowserErrorChanged" />
        <div class="selection-dock" aria-live="polite"><strong>@immichSelection.Count selected</strong><span>Selection is preserved across pages.</span></div>
    }
    else
    {
        <div @ref="dropZone" class="upload-drop-zone" tabindex="0" role="button" aria-label="Drop video files here or open the file picker">
            <p class="mb-2">Drag and drop video files here</p><button type="button" class="btn btn-outline-primary" @onclick="OpenPickerAsync" disabled="@IsLocked">Choose files</button><input data-upload-picker type="file" multiple class="visually-hidden" />
        </div>
        @if (files.Count > 0)
        {
            <div class="table-responsive mt-3"><table class="table align-middle wizard-card-table upload-table"><thead><tr><th>File</th><th>Status</th><th>Progress</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
            @foreach (var file in files) { <tr @key="file.ClientId"><td class="text-break">@file.FileName</td><td>@file.State @if (file.ErrorCode is not null) { <div class="text-danger small">@file.ErrorCode: @file.ErrorMessage</div> }</td><td><progress class="w-100" max="100" value="@file.Progress" aria-label="Upload progress for @file.FileName">@file.Progress%</progress></td><td class="text-end">@if (file.CanRetry) { <button class="btn btn-sm btn-outline-primary" @onclick="() => RetryAsync(file.ClientId)">Retry</button> } @if (!file.IsUploading && !file.IsServerKnown) { <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAsync(file.ClientId)">Remove</button> }</td></tr> }
            </tbody></table></div>
            <button class="btn btn-outline-primary" disabled="@(files.All(x => x.IsServerKnown || x.IsUploading) || IsLocked)" @onclick="UploadAsync">Upload selected files</button>
        }
    }
</section>
<div class="wizard-actions"><button class="btn btn-outline-secondary" @onclick="() => OpenStep(1)">Back</button><button class="btn btn-primary" disabled="@(!CanContinueFromSelection)" @onclick="ContinueFromSelectionAsync">Continue to compression</button></div>
}

@if (batch is not null && activeStep == 3)
{
<section class="mb-4" aria-labelledby="compression-heading">
    <h2 id="compression-heading" class="h4">3. Compression</h2>
    @if (IsLocked) { <div class="alert alert-info">This batch is confirmed. Its option snapshots can no longer be edited.</div> }
    <label class="form-label" for="global-preset">Global built-in preset</label>
    <select id="global-preset" class="form-select" value="@globalPreset.Value" @onchange="GlobalPresetChanged" disabled="@IsLocked">@foreach (var preset in Wizard.Presets) { <option value="@preset.Id.Value">@preset.Name</option> }</select>
    <details class="advanced-settings mt-3">
    <summary>Advanced settings</summary>
    <div class="row g-3 mt-1">
        <div class="col-md-2"><label class="form-label" for="crf">CRF</label><InputNumber id="crf" class="form-control" @bind-Value="crf" min="18" max="36" disabled="@IsLocked" />@if (crf > 30) { <div class="text-warning" role="status">CRF above 30 can visibly reduce quality.</div> }</div>
        <div class="col-md-2"><label class="form-label" for="video-codec">Video codec</label><InputSelect id="video-codec" class="form-select" @bind-Value="videoCodec" disabled="@IsLocked"><option value="H264">H.264</option><option value="H265">H.265 / HEVC</option></InputSelect></div>
        <div class="col-md-2"><label class="form-label" for="speed">Encoder speed</label><InputSelect id="speed" class="form-select" @bind-Value="speed" disabled="@IsLocked">@foreach (var value in Enum.GetValues<EncoderPreset>()) { <option value="@value">@value</option> }</InputSelect></div>
        <div class="col-md-2"><label class="form-label" for="resolution">Maximum</label><InputSelect id="resolution" class="form-select" @bind-Value="resolution" disabled="@IsLocked">@foreach (var value in Enum.GetValues<MaximumResolution>()) { <option value="@value">@ResolutionLabel(value)</option> }</InputSelect></div>
        <div class="col-md-2"><label class="form-label" for="audio">Audio</label><InputSelect id="audio" class="form-select" @bind-Value="audio" disabled="@IsLocked"><option value="Auto">Auto</option><option value="Copy">Copy</option><option value="Aac">AAC</option></InputSelect></div>
        <div class="col-md-2"><label class="form-label" for="suffix">Filename suffix</label><InputText id="suffix" class="form-control" @bind-Value="suffix" disabled="@IsLocked" /></div>
    </div>
    </details>
    <div class="table-responsive mt-3"><table class="table wizard-card-table preset-table"><thead><tr><th>Video</th><th>Preset</th></tr></thead><tbody>
    @foreach (var job in batch.Jobs) { <tr><td>@job.FileName</td><td><select class="form-select" aria-label="Preset for @job.FileName" value="@SelectedPreset(job.Id)" @onchange="e => PerVideoChanged(job.Id, e.Value?.ToString())" disabled="@IsLocked"><option value="">Use global</option>@foreach (var preset in Wizard.Presets) { <option value="@preset.Id.Value">@preset.Name</option> }</select></td></tr> }
    </tbody></table></div>
</section>
<div class="wizard-actions"><button class="btn btn-outline-secondary" @onclick="() => OpenStep(2)">Back</button>@if (!IsLocked) { <button class="btn btn-primary" disabled="@(batch.Jobs.Count == 0)" @onclick="SaveAndShowSummaryAsync">Review summary</button> }</div>
}

@if (IsLocked && batch is not null && activeStep == 6)
{
<section class="mt-4" aria-labelledby="publication-heading">
    <h2 id="publication-heading" class="h4">6. Publication</h2>
    @if (batch.SourceKind == SourceKind.Immich)
    {
        <p>Destination is locked to the source Immich connection.</p>
    }
    else
    {
        <label class="form-label" for="publish-destination">Immich destination</label>
        <select id="publish-destination" class="form-select mb-3" @bind="publicationDestination">
            <option value="">Choose a publish-capable connection</option>
            @foreach (var connection in publishConnections) { <option value="@connection.Id.Value">@connection.DisplayName</option> }
        </select>
    }
    <div class="table-responsive"><table class="table align-middle wizard-card-table publication-table"><thead><tr><th>Select</th><th>Result</th><th>Publication</th><th>Confirmation / status</th></tr></thead><tbody>
    @foreach (var job in batch.Jobs.Where(x => x.HasOutput && x.State is JobState.Ready or JobState.NotBeneficial))
    {
        <tr>
            <td><input type="checkbox" class="form-check-input" aria-label="Select @job.FileName for publication"
                checked="@publicationSelection.Contains(job.Id)" disabled="@(publishing || job.PublicationState == PublicationState.Published)"
                @onchange="e => SetPublicationSelected(job.Id, e.Value is true)" /></td>
            <td>@job.FileName</td>
            <td>
                @if (publishingJobs.Contains(job.Id))
                {
                    <span class="d-inline-flex align-items-center gap-2" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>Publishing...</span>
                }
                else
                {
                    <span class="badge @PublicationBadge(PublicationStateFor(job))">@PublicationLabel(PublicationStateFor(job))</span>
                }
                @if (PublishedAssetIdFor(job) is { } assetId)
                {
                    <div class="small text-break">Immich asset @assetId</div>
                    @if (ImmichAssetUrl(job) is { } assetUrl)
                    {
                        <a class="btn btn-sm btn-outline-primary mt-1" href="@assetUrl" target="_blank" rel="noopener noreferrer">Open in Immich <span aria-hidden="true">↗</span></a>
                    }
                }
            </td>
            <td>
                @if (job.State == JobState.NotBeneficial && !job.NotBeneficialPublicationOverride)
                {
                    <div class="form-check"><input type="checkbox" class="form-check-input" id="@($"force-{job.Id.Value:D}")"
                        checked="@publicationForce.Contains(job.Id)" @onchange="e => SetPublicationForce(job.Id, e.Value is true)" />
                    <label class="form-check-label" for="@($"force-{job.Id.Value:D}")">Force this NotBeneficial result</label></div>
                }
                @if (publicationResults.TryGetValue(job.Id, out var outcome))
                {
                    @foreach (var warning in outcome.Warnings) { <div class="text-warning small">@warning</div> }
                    @if (outcome.PendingAlbumIds.Count > 0) { <div class="text-warning small">Pending albums: @string.Join(", ", outcome.PendingAlbumIds)</div> }
                    @if (outcome.ErrorCode is not null) { <div class="text-danger small"><strong>Publication failed:</strong> @PublicationError(outcome.ErrorCode)</div> }
                    else if (outcome.State == PublicationState.Published) { <div class="text-success small"><strong>Successfully published to Immich.</strong></div> }
                }
            </td>
        </tr>
    }
    </tbody></table></div>
    @if (publicationSummary is not null) { <div class="alert @publicationSummaryClass mt-3 mb-2" role="status" aria-live="polite">@publicationSummary</div> }
    <button class="btn btn-success" disabled="@(publishing || publicationSelection.Count == 0 || ResolvePublicationDestination() is null)" @onclick="PublishSelectedAsync">
        @if (publishing) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }@(publishing ? $"Publishing {publishedCount}/{publishingTotal}..." : "Publish selected")
    </button>
</section>
<div class="wizard-actions"><button class="btn btn-outline-secondary" @onclick="() => OpenStep(5)">Back to processing</button><a class="btn btn-outline-primary" href="batches">View all batches</a></div>
}

@if (IsLocked && batch is not null && activeStep == 5)
{
<section class="mt-4" aria-labelledby="processing-heading">
    <h2 id="processing-heading" class="h4">5. Processing</h2>
    @if (batchProgress is not null)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2" role="status" aria-live="polite">
            @if (IsProcessing) { <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span> }
            <strong>@BatchActivityText</strong>
            <span class="text-body-secondary">@batchProgress.FinishedJobs of @batchProgress.TotalJobs finished · @batchProgress.FailedJobs failed · @batchProgress.CancelledJobs cancelled</span>
        </div>
        <progress class="w-100" max="100" value="@batchProgress.Percentage" aria-label="Batch progress">@batchProgress.Percentage%</progress>
        <div class="form-text">Updates automatically every second. Last update: @LastUpdatedText</div>
    }
    <button class="btn btn-sm btn-outline-secondary mt-2" disabled="@refreshing" @onclick="RefreshResultsAsync">@(refreshing ? "Refreshing..." : "Refresh now")</button>
    <div class="table-responsive mt-3"><table class="table align-middle wizard-card-table processing-table"><thead><tr><th>Video</th><th>State</th><th>Progress</th><th>Compressed size / savings</th><th>Technical details</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
    @foreach (var job in OrderedJobs)
    {
        var runtime = runtimes.GetValueOrDefault(job.Id);
        <tr><td>@job.FileName
            @foreach (var finding in job.Findings) { <div class="small @(finding.IsBlocking ? "text-danger" : "text-warning")">@finding.Code: @finding.Message</div> }
        </td><td><span class="d-inline-flex align-items-center gap-2">@if (IsActive(runtime?.State ?? job.State)) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }<span>@StateText(runtime?.State ?? job.State)</span></span></td><td>
            <div>@ProgressText(runtime?.Progress, runtime?.State ?? job.State)</div>
            @if (ProgressPercentage(runtime?.Progress, runtime?.State ?? job.State) is decimal jobPercent)
            {
                <progress class="w-100" max="100" value="@jobPercent" aria-label="Progress for @job.FileName">@jobPercent%</progress>
            }
        </td><td>
            @if (runtime?.Progress?.Compression?.OutputBytes is long outputBytes)
            {
                <div><strong>@Bytes(outputBytes)</strong></div>
                <div class="small @SavingsClass(job.SizeBytes, outputBytes)">@SavingsText(job.SizeBytes, outputBytes)</div>
                @if ((runtime?.State ?? job.State) == JobState.Compressing) { <div class="small text-body-secondary">Current encoded size</div> }
            }
            else { <span class="text-body-secondary">—</span> }
        </td><td>
            <details><summary>FPS, bitrate and log</summary>
                <div>FPS: @(runtime?.Progress?.Compression?.FramesPerSecond?.ToString("N1") ?? "—")</div>
                <div>Bitrate: @Bitrate(runtime?.Progress?.Compression?.BitrateBitsPerSecond)</div>
                <ul class="small mb-0">@foreach (var entry in runtime?.Logs ?? []) { <li><code>@entry.Code</code> @entry.Message</li> }</ul>
            </details>
        </td><td class="text-end">
            @if ((runtime?.State ?? job.State) is JobState.Failed or JobState.Cancelled or JobState.Interrupted) { <button class="btn btn-sm btn-outline-primary" @onclick="() => RetryJobAsync(job.Id)">Retry</button> }
            else if ((runtime?.State ?? job.State) is JobState.Acquiring or JobState.Probing or JobState.Queued or JobState.Compressing or JobState.Validating) { <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelJobAsync(job.Id)">Cancel</button> }
            @if (job.HasOutput && job.State is JobState.Ready or JobState.NotBeneficial)
            {
                <a class="btn btn-sm btn-primary ms-1" href="@($"/api/results/{job.Id.Value:D}/download")">Download</a>
                <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => RecompressAsync(job)">Recompress</button>
                @if (job.State == JobState.NotBeneficial && !job.NotBeneficialPublicationOverride)
                { <button class="btn btn-sm btn-outline-warning ms-1" @onclick="() => ForcePublicationAsync(job.Id)">Allow later publication</button> }
                else if (job.NotBeneficialPublicationOverride) { <span class="badge text-bg-warning ms-1">Publication forced</span> }
            }
        </td></tr>
    }
    </tbody></table></div>
    @if (batch.Status is BatchStatus.Acquiring or BatchStatus.Processing) { <button class="btn btn-outline-danger" @onclick="CancelBatchAsync">Cancel batch</button> }
</section>
<div class="wizard-actions"><span></span><button class="btn btn-primary" disabled="@(!HasPublishableResults)" @onclick="() => OpenStep(6)">Continue to results</button></div>
}

@if (showSummary && batch is not null && activeStep == 4)
{
<section aria-labelledby="summary-heading">
    <h2 id="summary-heading" class="h4">4. Summary</h2>
    <p><strong>@batch.Jobs.Count</strong> videos · source artifacts @Bytes(batch.Capacity.SourceBytes) · required capacity @Bytes(batch.Capacity.RequiredBytes) · available @Bytes(batch.Capacity.AvailableBytes).</p>
    @if (batch.Capacity.HasWarning) { <div class="alert alert-warning" role="alert">Capacity estimate is @batch.Capacity.Reason. Compression cannot be confirmed without the explicit override.</div><div class="form-check"><InputCheckbox id="force-capacity" class="form-check-input" @bind-Value="forceCapacity" disabled="@IsLocked" /><label class="form-check-label" for="force-capacity">Force processing despite low capacity</label></div> }
    <div class="table-responsive"><table class="table wizard-card-table summary-table"><thead><tr><th>Video</th><th>Source size</th><th>Persisted effective options</th></tr></thead><tbody>@foreach (var job in batch.Jobs) { <tr><td>@job.FileName</td><td>@Bytes(job.SizeBytes)</td><td>@CodecLabel(job.EffectiveOptions.VideoCodec), CRF @job.EffectiveOptions.Crf, @job.EffectiveOptions.EncoderPreset, @ResolutionLabel(job.EffectiveOptions.MaximumResolution), @job.EffectiveOptions.AudioMode, @job.EffectiveOptions.Suffix</td></tr> }</tbody></table></div>
</section>
<div class="wizard-actions"><button class="btn btn-outline-secondary" @onclick="() => OpenStep(3)">Back</button>@if (!IsLocked) { <button class="btn btn-success" disabled="@(batch.Capacity.RequiresOverride && !forceCapacity)" @onclick="ConfirmAsync">Confirm and start</button> }</div>
}

@code {
    private ElementReference dropZone; private IJSObjectReference? module; private DotNetObjectReference<NewBatch>? self; private bool uploadInitialized;
    private SourceKind sourceKind = SourceKind.BrowserUpload; private string batchName = $"Browser upload {DateTime.Now:yyyy-MM-dd HH:mm}";
    private BatchWizardView? batch; private ConnectionId? immichConnection; private IReadOnlyList<BatchSelection> immichSelection = [];
    private readonly List<UploadRow> files = []; private readonly Dictionary<JobId, PresetId> perVideo = [];
    private PresetId globalPreset = new("balanced"); private VideoCodec videoCodec = VideoCodec.H264; private int crf = 24; private EncoderPreset speed = EncoderPreset.Medium;
    private MaximumResolution resolution = MaximumResolution.Keep; private AudioMode audio = AudioMode.Auto; private string suffix = "_V";
    private int activeStep = 1; private bool showSummary, forceCapacity; private string? errorCode, error;
    private bool refreshing, runningAction; private DateTimeOffset? lastUpdated;
    private readonly CancellationTokenSource refreshCancellation = new(); private Task? refreshLoop;
    private readonly Dictionary<JobId, JobRuntimeView> runtimes = []; private BatchProgressView? batchProgress;
    private readonly HashSet<JobId> publicationSelection = []; private readonly HashSet<JobId> publicationForce = [];
    private readonly HashSet<JobId> publishingJobs = []; private bool publishing; private int publishedCount, publishingTotal;
    private string? publicationSummary, publicationSummaryClass;
    private readonly Dictionary<JobId, PublicationResult> publicationResults = [];
    private IReadOnlyList<ImmichConnectionView> allConnections = []; private IReadOnlyList<ImmichConnectionView> publishConnections = []; private string publicationDestination = "";
    private bool IsPersisted => batch is not null; private bool IsLocked => batch is not null && batch.Status != BatchStatus.Draft;
    private bool IsProcessing => batchProgress?.Status is BatchStatus.Acquiring or BatchStatus.Processing;
    private bool CanContinueFromSelection => sourceKind == SourceKind.Immich
        ? immichConnection is not null && immichSelection.Count > 0 && !IsLocked
        : batch is not null && batch.Jobs.Count > 0 && !files.Any(x => x.IsUploading);
    private bool HasPublishableResults => batch?.Jobs.Any(x => x.HasOutput && x.State is JobState.Ready or JobState.NotBeneficial) == true;
    private IReadOnlyList<BatchJobView> OrderedJobs => batch?.Jobs.OrderBy(x => JobDisplayOrder(runtimes.GetValueOrDefault(x.Id)?.State ?? x.State)).ThenBy(x => x.FileName, StringComparer.OrdinalIgnoreCase).ToArray() ?? [];
    private static readonly WizardStep[] Steps = [new(1, "Source"), new(2, "Videos"), new(3, "Compression"), new(4, "Review"), new(5, "Processing"), new(6, "Results")];
    private string StepDescription => activeStep switch { 1 => "Choose where the videos come from.", 2 => "Select the videos to compress.", 3 => "Choose quality and output settings.", 4 => "Check capacity and effective settings before starting.", 5 => "Follow every video without losing sight of failures.", 6 => "Download or publish completed results.", _ => "" };
    private string BatchActivityText => batchProgress?.Status switch { BatchStatus.Acquiring => "Acquiring source videos", BatchStatus.Processing => "Processing videos", BatchStatus.Completed => "Processing complete", BatchStatus.Cancelled => "Batch cancelled", _ => "Preparing batch" };
    private string LastUpdatedText => lastUpdated?.ToLocalTime().ToString("HH:mm:ss") ?? "waiting for the first update";

    protected override async Task OnInitializedAsync() { ProgressHub.Changed += ProgressChanged; refreshLoop = RefreshLoopAsync(refreshCancellation.Token); allConnections = await Connections.ListAsync(); publishConnections = allConnections.Where(x => x.Enabled && x.Compatibility == CompatibilityResult.Compatible && x.Capabilities.CanPublish).ToArray(); var preferred = publishConnections.FirstOrDefault(x => x.IsDefault) ?? publishConnections.FirstOrDefault(); publicationDestination = preferred?.Id.Value.ToString("D") ?? ""; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (activeStep != 2 || sourceKind != SourceKind.BrowserUpload || uploadInitialized) return;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./browser-uploads.js");
        self ??= DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("initialize", dropZone, self);
        uploadInitialized = true;
        await module.InvokeVoidAsync("restore");
    }
    private Task OpenPickerAsync() => module!.InvokeVoidAsync("openPicker").AsTask();
    private bool CanOpenStep(int step) => step switch { <= 2 => !IsLocked, 3 => batch is not null && !IsLocked, 4 => batch is not null && showSummary && !IsLocked, 5 => IsLocked, 6 => IsLocked && HasPublishableResults, _ => false };
    private void OpenStep(int step) { if (CanOpenStep(step) || step == 2 && !IsLocked) { if (activeStep == 2 && step != 2) uploadInitialized = false; activeStep = step; } }
    private void DismissError() { errorCode = null; error = null; }
    private void SetSource(SourceKind value) { sourceKind = value; uploadInitialized = false; batchName = $"{(value == SourceKind.Immich ? "Immich" : "Browser upload")} {DateTime.Now:yyyy-MM-dd HH:mm}"; }
    private Task UploadAsync() => module!.InvokeVoidAsync("uploadAll", batchName).AsTask(); private Task RetryAsync(string id) => module!.InvokeVoidAsync("retry", id, batchName).AsTask();
    private async Task RemoveAsync(string id) { await module!.InvokeVoidAsync("remove", id); files.RemoveAll(x => x.ClientId == id); }
    private Task ImmichConnectionChangedAsync(ConnectionId? id) { immichConnection = id; return Task.CompletedTask; }
    private void ImmichSelectionChanged(IReadOnlyList<BatchSelection> value) => immichSelection = value;
    private void ImmichBrowserErrorChanged(ImmichVideoBrowser.BrowserError? value) { errorCode = value?.Code; error = value?.Message; }
    private async Task ContinueFromSelectionAsync()
    {
        if (sourceKind == SourceKind.Immich) await CreateImmichBatchAsync();
        else if (batch is not null) { uploadInitialized = false; activeStep = 3; }
    }
    private async Task CreateImmichBatchAsync() => await RunAsync(async () => { batch = await Wizard.CreateAsync(SourceKind.Immich, immichConnection, batchName); batch = await Wizard.AddImmichSelectionAsync(batch.Id, immichSelection); LoadOptions(batch.DefaultOptions); activeStep = 3; });
    private async Task GlobalPresetChanged(ChangeEventArgs e) { globalPreset = new(e.Value?.ToString() ?? "balanced"); LoadOptions(BuiltInPresets.Snapshot(globalPreset)); await InvokeAsync(StateHasChanged); }
    private void PerVideoChanged(JobId id, string? value) { if (string.IsNullOrEmpty(value)) perVideo.Remove(id); else perVideo[id] = new(value); }
    private string SelectedPreset(JobId id) => perVideo.TryGetValue(id, out var value) ? value.Value : "";
    private async Task SaveAndShowSummaryAsync() => await RunAsync(async () => { var options = new CompressionOptions(crf, speed, resolution, audio, suffix, videoCodec); batch = await Wizard.SaveSettingsAsync(batch!.Id, new(batchName, globalPreset, options, perVideo)); showSummary = true; activeStep = 4; });
    private async Task ConfirmAsync() => await RunAsync(async () => { batch = await Wizard.ConfirmAsync(batch!.Id, forceCapacity); showSummary = true; activeStep = 5; await RefreshRuntimeAsync(); });
    private async Task RefreshRuntimeAsync() { if (batch is null) return; foreach (var job in batch.Jobs) { var value = await WorkerStore.GetRuntimeAsync(job.Id); if (value is not null) runtimes[job.Id] = value; var publication = await Publications.GetAsync(job.Id); if (publication is not null) publicationResults[job.Id] = publication; } batchProgress = await WorkerStore.GetBatchProgressAsync(batch.Id); lastUpdated = Time.GetUtcNow(); }
    private async Task RefreshResultsAsync() => await RunAsync(async () => { refreshing = true; try { batch = await Wizard.GetAsync(batch!.Id); await RefreshRuntimeAsync(); } finally { refreshing = false; } });
    private async Task RecompressAsync(BatchJobView job) => await RunAsync(async () => { await Results.RecompressAsync(job.Id, new(job.PresetId, job.EffectiveOptions)); batch = await Wizard.GetAsync(batch!.Id); await RefreshRuntimeAsync(); });
    private async Task ForcePublicationAsync(JobId id) => await RunAsync(async () => { await Results.AuthorizeNotBeneficialPublicationAsync(id); batch = await Wizard.GetAsync(batch!.Id); });
    private void SetPublicationSelected(JobId id, bool selected) { if (selected) publicationSelection.Add(id); else publicationSelection.Remove(id); }
    private void SetPublicationForce(JobId id, bool forced) { if (forced) publicationForce.Add(id); else publicationForce.Remove(id); }
    private ConnectionId? ResolvePublicationDestination() => batch?.SourceKind == SourceKind.Immich ? batch.ConnectionId
        : Guid.TryParse(publicationDestination, out var id) ? ConnectionId.From(id) : null;
    private async Task PublishSelectedAsync() => await RunAsync(async () =>
    {
        var destination = ResolvePublicationDestination() ?? throw new InvalidOperationException("Choose a publish-capable destination.");
        var selected = publicationSelection.Select(id => new PublicationSelection(id, publicationForce.Contains(id))).ToArray();
        publishing = true; publishedCount = 0; publishingTotal = selected.Length; publicationSummary = null;
        publishingJobs.Clear(); foreach (var item in selected) publishingJobs.Add(item.JobId);
        await InvokeAsync(StateHasChanged); await Task.Yield();
        var progress = new Progress<PublicationResult>(result =>
        {
            publicationResults[result.JobId] = result; publishingJobs.Remove(result.JobId); publishedCount++;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            var results = await Publications.PublishAsync(batch!.Id, destination, selected, progress);
            foreach (var result in results) publicationResults[result.JobId] = result;
            var succeeded = results.Count(x => x.State == PublicationState.Published);
            var partial = results.Count(x => x.State == PublicationState.PartiallyPublished);
            var failed = results.Count - succeeded - partial;
            publicationSummary = $"Publication finished: {succeeded} succeeded, {partial} partially published, {failed} failed.";
            publicationSummaryClass = failed == 0 && partial == 0 ? "alert-success" : succeeded > 0 || partial > 0 ? "alert-warning" : "alert-danger";
            publicationSelection.Clear(); batch = await Wizard.GetAsync(batch.Id); await RefreshRuntimeAsync();
        }
        finally { publishing = false; publishingJobs.Clear(); }
    });
    private PublicationState PublicationStateFor(BatchJobView job) => publicationResults.TryGetValue(job.Id, out var result) ? result.State : job.PublicationState;
    private string? PublishedAssetIdFor(BatchJobView job) => publicationResults.TryGetValue(job.Id, out var result) ? result.AssetId : job.PublishedAssetId;
    private string? ImmichAssetUrl(BatchJobView job)
    {
        var assetId = PublishedAssetIdFor(job); if (string.IsNullOrWhiteSpace(assetId)) return null;
        var destination = publicationResults.TryGetValue(job.Id, out var result) ? result.DestinationConnectionId : batch?.ConnectionId;
        var connection = destination is null ? null : allConnections.FirstOrDefault(x => x.Id == destination.Value);
        if (connection is null || !Uri.TryCreate(connection.BaseUrl, UriKind.Absolute, out var root)) return null;
        return new Uri(root, $"photos/{Uri.EscapeDataString(assetId)}").AbsoluteUri;
    }
    private static string PublicationLabel(PublicationState state) => state switch { PublicationState.NotRequested => "Not published", PublicationState.Publishing => "Publishing", PublicationState.Published => "Published", PublicationState.PartiallyPublished => "Partially published", PublicationState.Failed => "Failed", _ => state.ToString() };
    private static string PublicationBadge(PublicationState state) => state switch { PublicationState.Published => "text-bg-success", PublicationState.PartiallyPublished => "text-bg-warning", PublicationState.Failed => "text-bg-danger", PublicationState.Publishing => "text-bg-primary", _ => "text-bg-secondary" };
    private static string PublicationError(string code) => code switch { "publication.upload.ambiguous" => "The upload result is uncertain. Retry safely checks Immich before uploading again.", "publication.album.sync_failed" => "The video was uploaded, but one or more albums could not be synchronized. Retry to finish synchronization.", "publication.force.required" => "Confirm publication of this result because it did not reduce the file size.", "publication.destination.changed" => "The destination differs from the original publication attempt.", "publication.connection.missing" => "The Immich connection no longer exists.", "publication.connection.unavailable" => "The Immich connection is unavailable or cannot publish.", "publication.http_error" => "Immich rejected the request.", _ => code };
    private async Task CancelJobAsync(JobId id) => await RunAsync(async () => { await WorkerStore.RequestJobCancellationAsync(id, Time.GetUtcNow()); await RefreshRuntimeAsync(); });
    private async Task RetryJobAsync(JobId id) => await RunAsync(async () => { await WorkerStore.RetryAsync(id, Time.GetUtcNow()); batch = await Wizard.GetAsync(batch!.Id); await RefreshRuntimeAsync(); });
    private async Task CancelBatchAsync() => await RunAsync(async () => { await WorkerStore.RequestBatchCancellationAsync(batch!.Id, Time.GetUtcNow()); batch = await Wizard.GetAsync(batch.Id); await RefreshRuntimeAsync(); });
    private void ProgressChanged(JobId id, JobProgressSnapshot progress) { if (!runtimes.TryGetValue(id, out var current)) return; runtimes[id] = current with { Progress = progress }; lastUpdated = progress.UpdatedAt; _ = InvokeAsync(StateHasChanged); }
    private static decimal? ProgressPercentage(JobProgressSnapshot? value, JobState state) => state switch
    {
        JobState.Acquiring when value?.Transfer is { TotalBytes: > 0 } transfer => decimal.Min(100m, 100m * transfer.BytesTransferred / transfer.TotalBytes.Value),
        JobState.Compressing => value?.Compression?.Percentage,
        JobState.Ready or JobState.NotBeneficial => 100m,
        _ => null
    };
    private static string ProgressText(JobProgressSnapshot? value, JobState state) => ProgressPercentage(value, state) is decimal percent ? $"{percent:N1}%" : state == JobState.Acquiring && value?.Transfer is { } transfer ? $"{transfer.BytesTransferred:N0} bytes transferred" : state switch { JobState.Probing => "Inspecting source metadata...", JobState.Queued => "Waiting for compression...", JobState.Validating => "Validating output...", JobState.Ready or JobState.NotBeneficial => "Complete", JobState.Failed => "Failed", JobState.Cancelled => "Cancelled", JobState.Interrupted => "Interrupted", _ => "Waiting..." };
    private static bool IsActive(JobState state) => state is JobState.Acquiring or JobState.Probing or JobState.Queued or JobState.Compressing or JobState.Validating;
    private static int JobDisplayOrder(JobState state) => state switch { JobState.Failed or JobState.Interrupted => 0, JobState.Cancelled => 1, JobState.Acquiring or JobState.Probing or JobState.Queued or JobState.Compressing or JobState.Validating => 2, _ => 3 };
    private static string StateText(JobState state) => state switch { JobState.Acquiring => "Acquiring", JobState.Probing => "Inspecting", JobState.Queued => "Queued", JobState.Compressing => "Compressing", JobState.Validating => "Validating", _ => state.ToString() };
    private static string SavingsText(long? sourceBytes, long outputBytes)
    {
        if (sourceBytes is not > 0) return "Savings unavailable";
        var savings = 100m * (sourceBytes.Value - outputBytes) / sourceBytes.Value;
        return savings >= 0 ? $"{savings:N1}% saved" : $"{-savings:N1}% larger";
    }
    private static string SavingsClass(long? sourceBytes, long outputBytes) => sourceBytes is > 0 && outputBytes < sourceBytes ? "text-success" : sourceBytes is > 0 && outputBytes >= sourceBytes ? "text-warning" : "text-body-secondary";
    private static string Bitrate(long? value) => value.HasValue ? $"{value.Value / 1000d:N0} kb/s" : "—";
    private void LoadOptions(CompressionOptions value) => (videoCodec, crf, speed, resolution, audio, suffix) = (value.VideoCodec, value.Crf, value.EncoderPreset, value.MaximumResolution, value.AudioMode, value.Suffix);
    private static string CodecLabel(VideoCodec value) => value == VideoCodec.H265 ? "H.265 / HEVC" : "H.264";
    private async Task RunAsync(Func<Task> action) { error = errorCode = null; runningAction = true; try { await action(); } catch (DomainException ex) { errorCode = ex.Code; error = ex.Message; } catch (ImmichConnectionException ex) { errorCode = ex.Code; error = ex.Message; } catch (Exception ex) { errorCode = "batch.invalid"; error = ex.Message; } finally { runningAction = false; } }
    private async Task RefreshLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (batch is null || !IsLocked || (batchProgress is not null && !IsProcessing) || runningAction || refreshing) continue;
                await InvokeAsync(async () =>
                {
                    refreshing = true;
                    try { batch = await Wizard.GetAsync(batch.Id); await RefreshRuntimeAsync(); errorCode = error = null; }
                    catch (OperationCanceledException) when (token.IsCancellationRequested) { }
                    catch (Exception ex) { errorCode = "processing.refresh_failed"; error = $"Live updates paused: {ex.Message}"; }
                    finally { refreshing = false; StateHasChanged(); }
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    private static string ResolutionLabel(MaximumResolution value) => value == MaximumResolution.Keep ? "Keep" : $"{(int)value}p";
    private static string Bytes(long? value) => value switch { null => "Unknown", < 1024 => $"{value} B", < 1024L * 1024 * 1024 => $"{value.Value / 1024d / 1024d:N1} MB", _ => $"{value.Value / 1024d / 1024d / 1024d:N2} GB" };

    [JSInvokable] public void FilesSelected(UploadFileInfo[] selected) { foreach (var item in selected) if (files.All(x => x.ClientId != item.ClientId)) files.Add(new(item.ClientId, item.FileName, "Ready", 0)); StateHasChanged(); }
    [JSInvokable] public void UploadProgress(string id, int percentage) { var file = files.FirstOrDefault(x => x.ClientId == id); if (file is not null) { file.State = "Uploading"; file.Progress = percentage; file.IsUploading = true; StateHasChanged(); } }
    [JSInvokable] public async Task UploadCompleted(string id, string state, string? code, string? message) { var file = files.FirstOrDefault(x => x.ClientId == id); if (file is not null) { file.State = state; file.Progress = code is null ? 100 : file.Progress; file.ErrorCode = code; file.ErrorMessage = message; file.IsUploading = false; file.IsServerKnown = true; } if (batch is not null) batch = await Wizard.GetAsync(batch.Id); StateHasChanged(); }
    [JSInvokable] public async Task BatchReady(string id) { batch = await Wizard.GetAsync(BatchId.From(Guid.Parse(id))); if (batch is not null) { batchName = batch.Name; LoadOptions(batch.DefaultOptions); activeStep = IsLocked ? 5 : 2; if (IsLocked) await RefreshRuntimeAsync(); } StateHasChanged(); }
    [JSInvokable] public void ServerState(ServerBatchState state) { batchName = state.Name; files.Clear(); files.AddRange(state.Files.Select(x => new UploadRow(x.JobId.ToString(), x.FileName, x.State, x.BytesReceived.HasValue ? 100 : 0) { ErrorCode = x.ErrorCode, ErrorMessage = x.ErrorMessage, IsServerKnown = true, HasLocalFile = false })); StateHasChanged(); }
    [JSInvokable] public void PageError(string code, string message) { errorCode = code; error = message; StateHasChanged(); }
    public async ValueTask DisposeAsync() { ProgressHub.Changed -= ProgressChanged; refreshCancellation.Cancel(); if (refreshLoop is not null) { try { await refreshLoop; } catch (OperationCanceledException) { } } refreshCancellation.Dispose(); if (module is not null) await module.DisposeAsync(); self?.Dispose(); }
    public sealed record UploadFileInfo(string ClientId, string FileName, long Size); public sealed record ServerBatchState(Guid BatchId, string Name, ServerFileState[] Files); public sealed record ServerFileState(Guid JobId, string FileName, string State, long? BytesReceived, string? ErrorCode, string? ErrorMessage);
    private sealed record WizardStep(int Number, string Label);
    private sealed class UploadRow(string clientId, string fileName, string state, int progress) { public string ClientId { get; } = clientId; public string FileName { get; } = fileName; public string State { get; set; } = state; public int Progress { get; set; } = progress; public string? ErrorCode { get; set; } public string? ErrorMessage { get; set; } public bool IsUploading { get; set; } public bool IsServerKnown { get; set; } public bool HasLocalFile { get; set; } = true; public bool CanRetry => ErrorCode is not null && !IsUploading && HasLocalFile; }
}
